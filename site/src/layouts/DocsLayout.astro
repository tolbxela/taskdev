---
import Base from './Base.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  activeSlug?: string;
}

const { title, description, activeSlug } = Astro.props;

const all = await getCollection('docs');
const nav = all
  .map((e) => ({ id: e.id.replace(/\.md$/, ''), title: e.data.title, order: e.data.order }))
  .sort((a, b) => a.order - b.order);
---
<Base title={title} description={description}>
  <section class="docs-hero">
    <div class="section-head">
      <h2>// docs</h2>
      <span class="rule"></span>
    </div>
  </section>

  <div class="docs-layout">
    <aside class="docs-side" aria-label="Documentation">
      <nav>
        <a href="/docs" class={activeSlug === undefined ? 'active' : ''}>Overview</a>
        {nav.map((n) => (
          <a
            href={`/docs/${n.id}`}
            class={activeSlug === n.id ? 'active' : ''}
          >{n.title}</a>
        ))}
      </nav>
      <div class="docs-side-foot">
        <a href="https://github.com/tolbxela/taskdev/tree/main/docs" rel="noopener">Source on GitHub ↗</a>
      </div>
    </aside>

    <article class="docs-article prose">
      <slot />
    </article>
  </div>
</Base>
