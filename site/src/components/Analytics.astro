---
// Site-specific analytics: consent banner + click tracking for install commands
// and outbound links. Event names match the Umami dashboard.
import AnalyticsConsent from './AnalyticsConsent.astro';
---
<style>
  :global([data-consent]) { --consent-accent: var(--accent, #a3e635); }
</style>
<AnalyticsConsent
  src="https://umami.tolbxela.com/script.js"
  websiteId="c1940209-8cc2-46b4-82af-fb87cb9ad3e5"
  storageKey="taskdev-analytics-consent"
  title="Help improve TaskDev"
  description="Allow anonymous page-view statistics to help improve the site. No advertising profiles, cross-site tracking, or cookies."
  toggleLabel="Anonymous usage statistics"
  declineLabel="No thanks"
  acceptLabel="Enable analytics"
/>
<script is:inline>
  // Click tracking: install commands, marketplace links, outbound
  function track(name, props) {
    if (window.umami && typeof window.umami.track === 'function') {
      props ? window.umami.track(name, props) : window.umami.track(name);
    }
  }
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t) return;
    var copyBtn = t.closest && t.closest('.install-cmd');
    if (copyBtn) {
      var cmd = copyBtn.textContent.trim();
      navigator.clipboard && navigator.clipboard.writeText(cmd).catch(function(){});
      copyBtn.classList.add('copied');
      setTimeout(function(){ copyBtn.classList.remove('copied'); }, 1200);
      track('install-cmd-copy', { cmd: cmd.length > 60 ? cmd.slice(0, 60) : cmd });
      return;
    }
    var a = t.closest && t.closest('a');
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (href.indexOf('http') !== 0) return;
    var host;
    try { host = new URL(href).hostname; } catch (_) { return; }
    if (host === location.hostname) return;
    if (host === 'marketplace.visualstudio.com') {
      track('install-click', { dest: 'vscode' });
    } else if (host === 'open-vsx.org') {
      track('install-click', { dest: 'ovsx' });
    } else if (host === 'github.com') {
      track('gh-click');
    } else if (host === 'medium.com' || host === 'dev.to') {
      track('writeup-click', { dest: host === 'medium.com' ? 'medium' : 'devto' });
    } else if (host === 'tolbxela.com') {
      track('author-click');
    } else {
      track('outbound-click', { host: host });
    }
  });
</script>
