---
// Consent-controlled Umami analytics + click tracking for outbound links and the
// copy-on-click install commands. One inline script, document-level
// delegation, no per-component listeners.
//
// Event names match the umami dashboard:
//   install-cmd-copy, install-click (vscode|ovsx), gh-click,
//   writeup-click (medium|devto), author-click, outbound-click.
---
<div class="consent" data-consent hidden role="dialog" aria-modal="false" aria-labelledby="consent-title" aria-describedby="consent-body">
  <div class="consent-card">
    <div class="consent-head">
      <span class="consent-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v18h18" />
          <rect x="7" y="13" width="3" height="5" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="12" y="9" width="3" height="9" rx="0.5" fill="currentColor" stroke="none" />
          <rect x="17" y="5" width="3" height="13" rx="0.5" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <div class="consent-headtext">
        <div class="consent-titlerow">
          <h2 id="consent-title">Help improve TaskDev</h2>
          <span class="consent-badge" data-consent-badge hidden>Saved</span>
        </div>
        <p id="consent-body">
          Allow anonymous page-view statistics to help improve the site. No advertising profiles,
          cross-site tracking, or cookies.
        </p>
      </div>
    </div>
    <button type="button" class="consent-toggle" role="switch" aria-checked="false" data-consent-toggle>
      <span class="consent-toggle-text">
        <span class="consent-toggle-title">Anonymous usage statistics</span>
        <span class="consent-toggle-state" data-consent-state>Off</span>
      </span>
      <span class="consent-track" aria-hidden="true"><span class="consent-knob"></span></span>
    </button>
    <div class="consent-actions">
      <button type="button" class="consent-btn" data-consent-decline>No thanks</button>
      <button type="button" class="consent-btn consent-btn--accept" data-consent-save>Enable analytics</button>
    </div>
  </div>
</div>
<script is:inline>
  var ANALYTICS_SRC = 'https://umami.tolbxela.com/script.js';
  var WEBSITE_ID = 'c1940209-8cc2-46b4-82af-fb87cb9ad3e5';
  var CONSENT_KEY = 'taskdev-analytics-consent';

  function readConsent() {
    try {
      var value = localStorage.getItem(CONSENT_KEY);
      return value === 'granted' || value === 'denied' ? value : null;
    } catch (_) {
      return null;
    }
  }

  function writeConsent(value) {
    try {
      localStorage.setItem(CONSENT_KEY, value);
    } catch (_) {}
  }

  function loadAnalytics() {
    if (document.querySelector('script[data-taskdev-analytics]')) return;
    var script = document.createElement('script');
    script.async = true;
    script.defer = true;
    script.src = ANALYTICS_SRC;
    script.setAttribute('data-website-id', WEBSITE_ID);
    script.setAttribute('data-taskdev-analytics', '');
    document.head.appendChild(script);
  }

  function flashSaved(badge) {
    if (!badge) return;
    badge.hidden = false;
    badge.classList.remove('is-flash');
    void badge.offsetWidth;
    badge.classList.add('is-flash');
  }

  function openConsent(banner) {
    if (!banner) return;
    if (banner.__seed) banner.__seed();
    banner.hidden = false;
    void banner.offsetWidth;
    banner.classList.add('is-open');
  }

  function closeConsent(banner) {
    if (!banner) return;
    banner.classList.remove('is-open');
    var done = function () {
      banner.hidden = true;
      banner.removeEventListener('transitionend', done);
    };
    banner.addEventListener('transitionend', done);
  }

  function initConsent() {
    var banner = document.querySelector('[data-consent]');
    var reopen = document.querySelector('[data-consent-reopen]');
    if (readConsent() === 'granted') loadAnalytics();
    if (reopen) {
      reopen.addEventListener('click', function (event) {
        event.preventDefault();
        openConsent(banner);
      });
    }
    if (!banner) return;

    var toggle = banner.querySelector('[data-consent-toggle]');
    var state = banner.querySelector('[data-consent-state]');
    var badge = banner.querySelector('[data-consent-badge]');
    var pending = readConsent() === 'granted';

    function syncToggle() {
      if (toggle) toggle.setAttribute('aria-checked', pending ? 'true' : 'false');
      banner.classList.toggle('is-on', pending);
      if (state) state.textContent = pending ? 'On' : 'Off';
    }

    banner.__seed = function () {
      var saved = readConsent();
      pending = saved === 'granted';
      syncToggle();
      if (badge) badge.hidden = saved === null;
    };
    banner.__seed();

    if (toggle) {
      toggle.addEventListener('click', function () {
        pending = !pending;
        syncToggle();
        if (badge) badge.hidden = true;
      });
    }

    function commit(enabled) {
      writeConsent(enabled ? 'granted' : 'denied');
      if (enabled) loadAnalytics();
      flashSaved(badge);
      setTimeout(function () { closeConsent(banner); }, 650);
    }

    var save = banner.querySelector('[data-consent-save]');
    var decline = banner.querySelector('[data-consent-decline]');
    if (save) {
      save.addEventListener('click', function () {
        pending = true;
        syncToggle();
        commit(true);
      });
    }
    if (decline) {
      decline.addEventListener('click', function () {
        pending = false;
        syncToggle();
        commit(false);
      });
    }

    if (readConsent() === null) openConsent(banner);
  }

  initConsent();

  function track(name, props) {
    if (window.umami && typeof window.umami.track === 'function') {
      props ? window.umami.track(name, props) : window.umami.track(name);
    }
  }
  document.addEventListener('click', function (e) {
    var t = e.target;
    if (!t) return;
    var copyBtn = t.closest && t.closest('.install-cmd');
    if (copyBtn) {
      var cmd = copyBtn.textContent.trim();
      navigator.clipboard && navigator.clipboard.writeText(cmd).catch(function(){});
      copyBtn.classList.add('copied');
      setTimeout(function(){ copyBtn.classList.remove('copied'); }, 1200);
      track('install-cmd-copy', { cmd: cmd.length > 60 ? cmd.slice(0, 60) : cmd });
      return;
    }
    var a = t.closest && t.closest('a');
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (href.indexOf('http') !== 0) return;
    var host;
    try { host = new URL(href).hostname; } catch (_) { return; }
    if (host === location.hostname) return;
    if (host === 'marketplace.visualstudio.com') {
      track('install-click', { dest: 'vscode' });
    } else if (host === 'open-vsx.org') {
      track('install-click', { dest: 'ovsx' });
    } else if (host === 'github.com') {
      track('gh-click');
    } else if (host === 'medium.com' || host === 'dev.to') {
      track('writeup-click', { dest: host === 'medium.com' ? 'medium' : 'devto' });
    } else if (host === 'tolbxela.com') {
      track('author-click');
    } else {
      track('outbound-click', { host: host });
    }
  });
</script>
