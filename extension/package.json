{
  "name": "taskdev",
  "displayName": "TaskDev",
  "description": "Manage long-running dev tasks from VS Code and MCP with shared process supervision, reliable start/stop, and file-backed logs for AI agents.",
  "version": "0.1.21",
  "publisher": "tolbxela",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "author": {
    "name": "Tolbxela"
  },
  "maintainers": [
    {
      "name": "Tolbxela"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tolbxela/taskdev.git"
  },
  "bugs": {
    "url": "https://github.com/Tolbxela/taskdev/issues"
  },
  "homepage": "https://taskdev.dev",
  "keywords": [
    "tasks",
    "task-runner",
    "process-manager",
    "process-supervisor",
    "dev-server",
    "logs",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "codex",
    "claude-code",
    "windsurf",
    "dev-tools"
  ],
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "scripts": {
    "log-smoke": "node -e \"console.log('taskdev log smoke stdout'); console.error('taskdev log smoke stderr')\"",
    "test": "node test/core.test.cjs"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:taskdev.tasks",
    "onCommand:taskdev.start",
    "onCommand:taskdev.stop",
    "onCommand:taskdev.moveTaskUp",
    "onCommand:taskdev.moveTaskDown",
    "onCommand:taskdev.addCategory",
    "onCommand:taskdev.showLog",
    "onCommand:taskdev.refresh",
    "onCommand:taskdev.openTasksFile",
    "onCommand:taskdev.createTasksFile",
    "onCommand:taskdev.installMcp",
    "onCommand:taskdev.sendFeedback",
    "onCommand:taskdev.toggleLogTail",
    "onCommand:taskdev.setLogFilter"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "contributes": {
    "configuration": {
      "title": "TaskDev",
      "properties": {
        "taskdev.logViewer.maxLines": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 100000,
          "description": "Maximum number of log lines kept in the TaskDev log viewer buffer. Older lines are dropped once this is exceeded."
        },
        "taskdev.logViewer.refreshIntervalMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "description": "How often (in milliseconds) the TaskDev log viewer refreshes while tailing. Bursty output is coalesced into at most one refresh per interval. Default 500ms (twice per second)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taskdev",
          "title": "TaskDev",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "taskdev": [
        {
          "id": "taskdev.tasks",
          "name": "Tasks",
          "icon": "$(list-tree)"
        }
      ]
    },
    "commands": [
      {
        "command": "taskdev.start",
        "title": "Start task",
        "icon": "$(play)"
      },
      {
        "command": "taskdev.stop",
        "title": "Stop task",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskdev.moveTaskUp",
        "title": "Move task up",
        "category": "TaskDev",
        "icon": "$(arrow-up)"
      },
      {
        "command": "taskdev.moveTaskDown",
        "title": "Move task down",
        "category": "TaskDev",
        "icon": "$(arrow-down)"
      },
      {
        "command": "taskdev.addCategory",
        "title": "Add category…",
        "category": "TaskDev",
        "icon": "$(folder)"
      },
      {
        "command": "taskdev.showLog",
        "title": "Show log",
        "icon": "$(output)"
      },
      {
        "command": "taskdev.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "taskdev.openTasksFile",
        "title": "Open task file",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskdev.createTasksFile",
        "title": "Create taskdev.json in folder…",
        "category": "TaskDev",
        "icon": "$(new-file)"
      },
      {
        "command": "taskdev.installMcp",
        "title": "Install MCP config",
        "icon": "$(plug)"
      },
      {
        "command": "taskdev.sendFeedback",
        "title": "Send feedback",
        "category": "TaskDev",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "taskdev.toggleLogTail",
        "title": "Toggle log tail (follow)",
        "category": "TaskDev",
        "icon": "$(arrow-down)"
      },
      {
        "command": "taskdev.setLogFilter",
        "title": "Filter log lines…",
        "category": "TaskDev",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "taskdev.setLogFilter",
          "when": "resourceScheme == taskdev-log",
          "group": "navigation@0"
        },
        {
          "command": "taskdev.toggleLogTail",
          "when": "resourceScheme == taskdev-log",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "taskdev.installMcp",
          "when": "view == taskdev.tasks",
          "group": "navigation@1"
        },
        {
          "command": "taskdev.openTasksFile",
          "when": "view == taskdev.tasks",
          "group": "navigation@2"
        },
        {
          "command": "taskdev.refresh",
          "when": "view == taskdev.tasks",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "taskdev.createTasksFile",
          "when": "explorerResourceIsFolder && explorerResourceIsRoot",
          "group": "taskdev@1"
        }
      ],
      "view/item/context": [
        {
          "command": "taskdev.start",
          "when": "view == taskdev.tasks && viewItem == stopped",
          "group": "inline@1"
        },
        {
          "command": "taskdev.stop",
          "when": "view == taskdev.tasks && viewItem == running",
          "group": "inline@1"
        },
        {
          "command": "taskdev.showLog",
          "when": "view == taskdev.tasks && (viewItem == running || viewItem == stopped)",
          "group": "inline@2"
        },
        {
          "command": "taskdev.moveTaskUp",
          "when": "view == taskdev.tasks && (viewItem == running || viewItem == stopped || viewItem == exited || viewItem == exited-unknown)",
          "group": "taskdev@1"
        },
        {
          "command": "taskdev.moveTaskDown",
          "when": "view == taskdev.tasks && (viewItem == running || viewItem == stopped || viewItem == exited || viewItem == exited-unknown)",
          "group": "taskdev@2"
        },
        {
          "command": "taskdev.addCategory",
          "when": "view == taskdev.tasks && (viewItem == running || viewItem == stopped || viewItem == exited || viewItem == exited-unknown)",
          "group": "taskdev@3"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
